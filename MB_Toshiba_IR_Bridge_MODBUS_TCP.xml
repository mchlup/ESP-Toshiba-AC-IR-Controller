  <ModbusCmd Title="Error code" Comment="0xFFFF=unknown" HintText="" ModbusAddress="9" ModbusCmd="3" ModbusPollingCycle="10" Unit="" Analog="false" Sensor="true"/>

  <!-- HR10: Status bits -->
  <ModbusCmd Title="Status bits" Comment="bit0=IR modul OK, bit1=MQTT, bit2=WiFi, bit3=Modbus..." HintText="" ModbusAddress="10" ModbusCmd="3" ModbusPollingCycle="5" Unit="" Analog="false" Sensor="true"/>

  <!-- HR11: Uptime (sekundy, low16) -->
  <ModbusCmd Title="Uptime (s, low16)" Comment="" HintText="" ModbusAddress="11" ModbusCmd="3" ModbusPollingCycle="10" Unit="&lt;v.0&gt; s" Analog="true" Sensor="true" SourceValHigh="100" DestValHigh="100"/>

