  <ModbusCmd Title="Swing (set)" Comment="0=fix,1=v_swing,2=h_swing,3=hv_swing,4=auto" HintText="" ModbusAddress="4" ModbusCmd="6" ModbusDataType="1" Unit="&lt;v.1&gt;" Analog="true" Sensor="false" SourceValHigh="10" DestValHigh="10" RepeatRate="10"/>
