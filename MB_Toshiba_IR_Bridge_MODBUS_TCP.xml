  <ModbusCmd Title="Operating state" Comment="0=auto,1=cool,2=heat,3=dry,4=fan_only,5=off – vypočtený stav" HintText="" ModbusAddress="7" ModbusCmd="3" ModbusPollingCycle="5" Unit="" Analog="false" Sensor="true"/>

