  <!-- HR0: Power -->
  <ModbusCmd Title="Power (write 0/1)" Comment="0=off, 1=on – při změně odešle IR příkaz" HintText="" ModbusCmd="6" Unit="" Analog="false" Sensor="false" RepeatRate="3600"/>

  <!-- HR1: Setpoint -->
  <ModbusCmd Title="Setpoint (write 17..30 °C)" Comment="Rozsah 17..30 °C, při změně odešle IR" HintText="" ModbusAddress="1" ModbusCmd="6" Unit="&lt;v.0&gt; °C" Analog="true" Sensor="false" SourceValHigh="100" DestValHigh="100" RepeatRate="3600"/>

  <!-- HR2: Mode –
       0=auto,1=cool,2=heat,3=dry,4=fan_only,5=off -->
  <ModbusCmd Title="Mode (set)" Comment="0=auto,1=cool,2=heat,3=dry,4=fan_only,5=off" HintText="" ModbusAddress="2" ModbusCmd="6" ModbusDataType="1" Unit="&lt;v&gt;" Analog="true" Sensor="false" SourceValHigh="10" DestValHigh="10" RepeatRate="5"/>

