  <ModbusCmd Title="Reserved 5" Comment="Rezervováno – podle FW" HintText="" ModbusAddress="5" ModbusCmd="3" ModbusPollingCycle="10" Unit="" Analog="false" Sensor="true"/>

  <!-- HR6: Rezerva / případné interní info (volitelně lze zobrazit) -->
  <ModbusCmd Title="Reserved 6" Comment="Rezervováno – podle FW" HintText="" ModbusAddress="6" ModbusCmd="3" ModbusPollingCycle="10" Unit="" Analog="false" Sensor="true"/>

