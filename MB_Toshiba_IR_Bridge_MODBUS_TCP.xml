<?xml version="1.0" encoding="utf-8"?>
<Modbus Title="Toshiba IR Bridge (ESP-Toshiba-IR-Controller) MODBUS-TCP" Comment="Ovládání klimatizace přes IR z Loxone (Modbus TCP)" HintText="" Channel="1">
