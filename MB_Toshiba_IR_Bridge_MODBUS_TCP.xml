  <ModbusCmd Title="Fan (state)" Comment="0=auto,1=quiet,2=low,3=medium,4=high,5=max" HintText="" ModbusAddress="3" ModbusCmd="3" ModbusPollingCycle="2" Unit="&lt;v&gt;" Analog="true" Sensor="true" SourceValHigh="10" DestValHigh="10"/>

