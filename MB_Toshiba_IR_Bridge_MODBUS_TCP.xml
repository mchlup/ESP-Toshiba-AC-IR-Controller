  <ModbusCmd Title="Setpoint" Comment="Požadovaná teplota" HintText="" ModbusAddress="1" ModbusCmd="3" ModbusPollingCycle="2" Unit="&lt;v.0&gt; °C" Analog="true" Sensor="true" SourceValHigh="100" DestValHigh="100"/>

  <!-- HR2: Režim (viz Mode (set)) -->
  <ModbusCmd Title="Mode (state)" Comment="0=auto,1=cool,2=heat,3=dry,4=fan_only,5=off" HintText="" ModbusAddress="2" ModbusCmd="3" ModbusDataType="1" ModbusPollingCycle="2" Unit="&lt;v&gt;" Analog="true" Sensor="true" SourceValHigh="100" DestValHigh="100"/>

