  <ModbusCmd Title="Swing (state)" Comment="0=fix,1=v_swing,2=h_swing,3=hv_swing,4=auto" HintText="" ModbusAddress="4" ModbusCmd="3" ModbusPollingCycle="2" Unit="&lt;v&gt;" Analog="true" Sensor="true" SourceValHigh="100" DestValHigh="100"/>

