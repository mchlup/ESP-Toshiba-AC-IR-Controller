  <!-- HR0: Power stav (0=off, 1=on) -->
  <ModbusCmd Title="Power (state)" Comment="0=off, 1=on – virtuální stav v IR bridge" HintText="" ModbusCmd="3" ModbusPollingCycle="2" Unit="" Analog="false" Sensor="true"/>

